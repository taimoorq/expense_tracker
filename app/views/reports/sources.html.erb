<% content_for :title, "#{@sources.category} report sources" %>
<% breadcrumb "Reports", reports_path %>
<% breadcrumb @sources.category %>
<% page_header title: @sources.category,
  eyebrow: "Report source records",
  subtitle: "Exact outflow records included from #{l(@sources.starts_on, format: :long)} through #{l(@sources.ends_on, format: :long)}." %>

<div class="space-y-6">
  <section class="ta-section-frame" aria-labelledby="report-source-title">
    <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
      <div><p class="ta-page-eyebrow">Source and freshness</p><h2 id="report-source-title" class="ta-section-title mt-1">Contributing transactions</h2><p class="mt-1 text-sm text-slate-600">Closed months use frozen line snapshots; open months use live canonical transactions. Calculation <%= @sources.calculation_version %>.</p></div>
      <div class="text-right"><p class="ta-ledger-label">Exact total</p><p class="ta-number mt-1 text-xl font-semibold text-slate-900"><%= number_to_currency(@sources.total) %></p></div>
    </div>
    <% if @sources.rows.any? %>
      <div class="overflow-x-auto border-t border-slate-200">
        <table class="min-w-full text-left text-sm">
          <caption class="sr-only">Transactions contributing to the <%= @sources.category %> report total</caption>
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-3 sm:px-5">Date</th><th class="px-4 py-3">Description</th><th class="px-4 py-3">Month</th><th class="px-4 py-3">Source</th><th class="px-4 py-3 text-right sm:px-5">Amount</th></tr></thead>
          <tbody class="divide-y divide-slate-200">
            <% @sources.rows.each do |row| %>
              <tr><td class="whitespace-nowrap px-4 py-3 text-slate-600 sm:px-5"><%= l(row.effective_on, format: :long) %></td><td class="min-w-52 px-4 py-3 font-semibold text-slate-900"><%= link_to row.description, row.detail_path, class: "hover:text-indigo-700" %></td><td class="px-4 py-3 text-slate-600"><%= row.month_label %></td><td class="px-4 py-3"><span class="ta-status-badge <%= row.source_label == "Closed snapshot" ? "bg-slate-100 text-slate-800" : "bg-sky-100 text-sky-800" %>"><%= row.source_label %></span></td><td class="ta-number whitespace-nowrap px-4 py-3 text-right font-semibold text-slate-900 sm:px-5"><%= number_to_currency(row.amount) %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="border-t border-slate-200 px-5 py-10 text-center"><h3 class="font-semibold text-slate-900">No contributing records</h3><p class="mt-2 text-sm text-slate-600">The report scope no longer contains a matching outflow record.</p></div>
    <% end %>
  </section>
  <%= link_to "Back to Reports", reports_path, class: "fb-btn-secondary ta-action-btn" %>
</div>
