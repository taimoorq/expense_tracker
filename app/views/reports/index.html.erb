<% content_for :title, "Reports" %>
<% content_for :head do %><%= chart_library_tags %><% end %>
<% page_header title: "Reports",
  eyebrow: "Patterns for the next decision",
  subtitle: "Compare plans with actual activity and trace every total back to its month or account." %>

<div class="space-y-6">
  <section class="ta-section-frame" aria-labelledby="plan-actual-report-title">
    <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
      <div><p class="ta-page-eyebrow">Plan versus actual</p><h2 id="plan-actual-report-title" class="ta-section-title mt-1">Monthly outflow</h2><p class="mt-1 text-sm text-slate-600">Open months use live values; closed months use their immutable close snapshots. Calculations: <%= @report.calculation_version %>.</p></div>
      <span class="ta-status-badge bg-slate-100 text-slate-700"><%= pluralize(@report.period_rows.size, "month") %></span>
    </div>
    <% if @report.period_rows.any? %>
      <div class="grid gap-0 border-t border-slate-200 xl:grid-cols-[minmax(0,1.35fr)_minmax(360px,0.85fr)]">
        <div class="min-h-80 border-b border-slate-200 p-4 xl:border-b-0 xl:border-r sm:p-5">
          <canvas data-controller="chart" data-chart-type-value="bar" data-chart-title-value="Planned and actual monthly outflow" data-chart-labels-value="<%= @report.labels.to_json %>" data-chart-datasets-value="<%= [
            { label: "Planned", data: @report.planned_outflow, backgroundColor: "rgba(79, 70, 229, 0.35)", borderColor: "#4f46e5", borderWidth: 1 },
            { label: "Actual", data: @report.actual_outflow, backgroundColor: "rgba(15, 118, 110, 0.55)", borderColor: "#0f766e", borderWidth: 1 }
          ].to_json %>" data-chart-options-value="<%= { scales: { y: { beginAtZero: true } } }.to_json %>"></canvas>
        </div>
        <div class="max-h-96 overflow-auto">
          <table class="min-w-full text-sm"><caption class="sr-only">Accessible values for the planned and actual monthly outflow chart</caption><thead class="sticky top-0 bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-3">Month</th><th class="px-4 py-3">Source</th><th class="px-4 py-3 text-right">Planned</th><th class="px-4 py-3 text-right">Actual</th><th class="px-4 py-3 text-right">Remaining</th></tr></thead><tbody class="divide-y divide-slate-200">
            <% @report.period_rows.each do |row| %><tr><td class="px-4 py-3 font-semibold"><%= link_to row.month.label, row.source_path, class: "hover:text-indigo-700" %></td><td class="px-4 py-3"><span class="ta-status-badge <%= row.close_id ? "bg-slate-100 text-slate-800" : "bg-sky-100 text-sky-800" %>"><%= row.source_label %></span><p class="mt-1 text-xs text-slate-500"><%= row.calculation_version %><%= row.closed_at ? " · closed #{l(row.closed_at.to_date, format: :long)}" : "" %></p></td><td class="ta-number px-4 py-3 text-right"><%= number_to_currency(row.summary.planned_outflow) %></td><td class="ta-number px-4 py-3 text-right"><%= number_to_currency(row.summary.actual_outflow) %></td><td class="ta-number px-4 py-3 text-right"><%= number_to_currency(row.summary.remaining_outflow) %></td></tr><% end %>
          </tbody></table>
        </div>
      </div>
    <% else %>
      <div class="border-t border-slate-200 px-5 py-10 text-center"><h3 class="font-semibold text-slate-900">No monthly history yet</h3><p class="mt-2 text-sm text-slate-600">Create a month and add planned items to build this comparison.</p></div>
    <% end %>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <article class="ta-section-frame" aria-labelledby="category-report-title">
      <div class="ta-section-header"><p class="ta-page-eyebrow">Spending</p><h2 id="category-report-title" class="ta-section-title mt-1">Actual outflow by category</h2><p class="mt-1 text-sm text-slate-600">Top categories across the months shown above.</p></div>
      <% if @report.category_labels.any? %>
        <div class="min-h-72 border-t border-slate-200 p-4"><canvas data-controller="chart" data-chart-type-value="doughnut" data-chart-title-value="Actual outflow by category" data-chart-labels-value="<%= @report.category_labels.to_json %>" data-chart-data-value="<%= @report.category_values.to_json %>"></canvas></div>
        <ul class="divide-y divide-slate-200 border-t border-slate-200"><% @report.category_rows.each do |row| %><li class="flex justify-between gap-3 px-5 py-3 text-sm"><%= link_to row.label, row.source_path, class: "font-semibold text-slate-900 hover:text-indigo-700" %><strong class="ta-number"><%= number_to_currency(row.value) %></strong></li><% end %></ul>
      <% else %><div class="border-t border-slate-200 px-5 py-10 text-center text-sm text-slate-600">Paid outflows with categories will appear here.</div><% end %>
    </article>

    <article class="ta-section-frame" aria-labelledby="net-worth-report-title">
      <div class="ta-section-header"><p class="ta-page-eyebrow">Balances and net worth</p><h2 id="net-worth-report-title" class="ta-section-title mt-1">Tracked position</h2><p class="mt-1 text-sm text-slate-600">Only accounts included in net worth contribute to this total.</p></div>
      <div class="grid grid-cols-3 divide-x divide-slate-200 border-t border-slate-200 text-center"><div class="p-4"><p class="ta-ledger-label">Assets</p><p class="ta-number mt-2 font-semibold"><%= number_to_currency(@report.account_summary[:assets_total]) %></p></div><div class="p-4"><p class="ta-ledger-label">Liabilities</p><p class="ta-number mt-2 font-semibold"><%= number_to_currency(@report.account_summary[:liabilities_total]) %></p></div><div class="p-4"><p class="ta-ledger-label">Net worth</p><p class="ta-number mt-2 font-semibold"><%= number_to_currency(@report.account_summary[:net_worth_total]) %></p></div></div>
      <% if @report.account_summary[:trend_labels].any? %><div class="min-h-72 border-t border-slate-200 p-4"><canvas data-controller="chart" data-chart-type-value="line" data-chart-title-value="Net worth history" data-chart-labels-value="<%= @report.account_summary[:trend_labels].to_json %>" data-chart-data-value="<%= @report.account_summary[:trend_values].to_json %>"></canvas></div><% end %>
      <div class="border-t border-slate-200 px-5 py-4"><%= link_to "Review account sources and history", accounts_path, class: "text-sm font-semibold text-indigo-700 hover:text-indigo-600" %></div>
    </article>
  </section>
</div>
