<%= turbo_frame_tag frame_id, class: "block" do %>
  <section class="border-y border-amber-200 bg-amber-50/70 px-4 py-4 sm:px-5" aria-labelledby="<%= frame_id %>_title">
    <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
      <div class="ta-ledger-rail">
        <p class="ta-page-eyebrow"><%= account_snapshot.persisted? ? "Correct trusted source" : "Resolve account balance" %></p>
        <h3 id="<%= frame_id %>_title" class="text-base font-semibold text-slate-900"><%= account_snapshot.persisted? ? "Edit #{account.name} snapshot" : "Add a balance for #{account.name}" %></h3>
        <p class="mt-1 text-xs leading-5 text-slate-600"><%= account_snapshot.persisted? ? "Correct the amount, date, or note. Later activity will be recalculated from this snapshot." : "Imported rows are saved. Add one balance and its as-of date to calculate the account from a trusted starting point." %></p>
      </div>
    </div>

    <%= render "accounts/snapshot_form",
      account: account,
      account_snapshot: account_snapshot,
      compact: true,
      cancel_path: accounts_path,
      form_namespace: frame_id,
      labelledby: "#{frame_id}_title" %>
  </section>
<% end %>
