<% breadcrumb "Recurring" %>

<% recurring_groups = [
  {
    label: "Pay Schedules",
    anchor: "pay-schedules",
    icon: "cash",
    icon_classes: "text-emerald-600",
    records: @pay_schedules,
    active_count: @pay_schedules.filter { |record| record.active_on?(Date.current) }.size,
    linked_count: @pay_schedules.filter { |record| record.try(:linked_account_id).present? || record.try(:payment_account_id).present? }.size,
    description: "Income that should appear in future months.",
    empty_hint: "Start here if paychecks are predictable."
  },
  {
    label: "Subscriptions",
    anchor: "subscriptions",
    icon: "repeat",
    icon_classes: "text-indigo-600",
    records: @subscriptions,
    active_count: @subscriptions.filter(&:active?).size,
    linked_count: @subscriptions.filter { |record| record.try(:linked_account_id).present? || record.try(:payment_account_id).present? }.size,
    description: "Recurring services and memberships.",
    empty_hint: "Save recurring services and memberships."
  },
  {
    label: "Monthly Bills",
    anchor: "monthly-bills",
    icon: "cash",
    icon_classes: "text-sky-600",
    records: @monthly_bills,
    active_count: @monthly_bills.filter(&:active?).size,
    linked_count: @monthly_bills.filter { |record| record.try(:linked_account_id).present? || record.try(:payment_account_id).present? }.size,
    description: "Fixed or variable bills by month.",
    empty_hint: "Add rent, utilities, insurance, or other bills."
  },
  {
    label: "Payment Plans",
    anchor: "payment-plans",
    icon: "chart-bar",
    icon_classes: "text-rose-600",
    records: @payment_plans,
    active_count: @payment_plans.filter(&:active?).size,
    linked_count: @payment_plans.filter { |record| record.try(:linked_account_id).present? || record.try(:payment_account_id).present? }.size,
    description: "Balances paid down over time.",
    empty_hint: "Track installment plans and payoff targets."
  },
  {
    label: "Credit Cards",
    anchor: "credit-cards",
    icon: "shield-lock",
    icon_classes: "text-violet-600",
    records: @credit_cards,
    active_count: @credit_cards.filter(&:active?).size,
    linked_count: @credit_cards.filter { |record| record.try(:linked_account_id).present? || record.try(:payment_account_id).present? }.size,
    description: "Estimated card payments from leftover cash.",
    empty_hint: "Schedule card payment estimates."
  }
] %>
<% recurring_total = recurring_groups.sum { |group| group[:records].size } %>
<% recurring_active_total = recurring_groups.sum { |group| group[:active_count] } %>
<% recurring_linked_total = recurring_groups.sum { |group| group[:linked_count] } %>
<% editing_recurring_section =
     if @pay_schedule.persisted?
       "pay-schedules"
     elsif @subscription.persisted?
       "subscriptions"
     elsif @monthly_bill.persisted?
       "monthly-bills"
     elsif @payment_plan.persisted?
       "payment-plans"
     elsif @credit_card.persisted?
       "credit-cards"
     end %>
<% default_recurring_section = editing_recurring_section || "pay-schedules" %>
<% recurring_tab_urls = recurring_groups.to_h { |group| [group[:anchor], planning_templates_path(anchor: group[:anchor])] } %>

<div class="space-y-6" data-controller="tabs" data-tabs-default-tab-value="<%= default_recurring_section %>" data-tabs-tab-urls-value="<%= recurring_tab_urls.to_json %>">
  <% page_header title: "Recurring Transactions",
    eyebrow: "Reusable planning catalog",
    subtitle: "Save predictable money movement once, then bring it into the months where it applies.",
    icon: "repeat" %>

  <section class="ta-section-frame">
    <div class="ta-section-header flex flex-col gap-5 xl:flex-row xl:items-start xl:justify-between">
      <div class="ta-ledger-rail max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Recurring payments</p>
        <h2 class="mt-2 text-xl font-semibold text-slate-900">Manage recurring payments by type</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Keep paychecks, subscriptions, bills, payment plans, and card payment estimates organized so each month can pull in the right planned entries.</p>
      </div>

      <div class="grid divide-y divide-slate-200 overflow-hidden rounded-[var(--ta-radius-md)] border border-slate-200 text-sm sm:grid-cols-3 sm:divide-x sm:divide-y-0 xl:min-w-[34rem]">
        <div class="bg-white/80 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Saved</p>
          <p class="mt-1 text-2xl font-semibold text-slate-900"><%= recurring_total %></p>
        </div>
        <div class="bg-white/80 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Active</p>
          <p class="mt-1 text-2xl font-semibold text-slate-900"><%= recurring_active_total %></p>
        </div>
        <div class="bg-white/80 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Linked</p>
          <p class="mt-1 text-2xl font-semibold <%= recurring_linked_total.positive? ? 'text-emerald-700' : 'text-slate-900' %>"><%= recurring_linked_total %></p>
        </div>
      </div>
    </div>

    <% if recurring_total.zero? %>
      <div class="border-t border-dashed border-indigo-200 bg-indigo-50/60 px-4 py-3 text-sm leading-6 text-slate-600">
        Start small: add one paycheck schedule and one recurring bill or subscription. You can add the rest after the first month shows what is actually useful.
      </div>
    <% end %>

    <div class="overflow-x-auto border-t border-slate-200 p-2 sm:px-4 sm:py-3">
      <div class="ta-tab-list min-w-max" role="tablist" aria-label="Recurring transaction types" style="view-transition-name: recurring-template-tabs; view-transition-class: ta-vt-nav;">
        <% recurring_groups.each do |group| %>
          <button type="button"
                  class="ta-tab <%= 'ta-tab-active' if group[:anchor] == default_recurring_section %>"
                  role="tab"
                  aria-selected="<%= (group[:anchor] == default_recurring_section).to_s %>"
                  data-tabs-target="tab"
                  data-tab-name="<%= group[:anchor] %>"
                  data-action="click->tabs#switch"
                  data-tabs-name-param="<%= group[:anchor] %>">
            <span class="inline-flex items-center gap-2">
              <%= tabler_icon(group[:icon], classes: "ta-tab-icon") %>
              <span class="hidden sm:inline"><%= group[:label] %></span>
              <span class="sm:hidden"><%= group[:label].split.first %></span>
            </span>
            <span class="rounded-full bg-white/20 px-2 py-0.5 text-xs font-semibold"><%= group[:records].size %></span>
          </button>
        <% end %>
      </div>
    </div>
  </section>

  <% if @upcoming_commitments.present? %>
    <section class="ta-section-frame" aria-labelledby="commitment-outlook-title">
      <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="ta-page-eyebrow">Planning horizon</p>
          <h2 id="commitment-outlook-title" class="ta-section-title mt-1">Upcoming 90-day commitments</h2>
          <p class="mt-1 text-sm text-slate-600">See when saved income, bills, payments, and transfers are concentrated before adding them to a month.</p>
        </div>
        <div class="text-right text-xs text-slate-500">
          <p><%= l(@upcoming_commitments.starts_on, format: :long) %>–<%= l(@upcoming_commitments.ends_on, format: :long) %></p>
          <p class="mt-1"><%= @upcoming_commitments.currency_code %> · <%= @upcoming_commitments.calculation_version %></p>
        </div>
      </div>

      <% if @upcoming_commitments.rows.any? %>
        <div class="grid gap-3 border-t border-slate-200 p-4 lg:grid-cols-2 xl:grid-cols-3" aria-label="Weekly upcoming planned income and commitments">
          <% @upcoming_commitments.weeks.each do |week| %>
            <% next if week.rows.empty? %>
            <% maximum = @upcoming_commitments.maximum_week_total %>
            <% income_width = maximum.positive? ? ((week.income / maximum) * 100).round(2) : 0 %>
            <% outflow_width = maximum.positive? ? ((week.outflow / maximum) * 100).round(2) : 0 %>
            <article class="rounded-2xl border border-slate-200 bg-white p-4">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-sm font-semibold text-slate-900"><%= week.starts_on.strftime("%b %-d") %>–<%= week.ends_on.strftime("%b %-d") %></h3>
                <span class="text-xs text-slate-500"><%= pluralize(week.rows.size, "item") %></span>
              </div>
              <div class="mt-3 space-y-3">
                <div>
                  <div class="flex justify-between gap-2 text-xs"><span class="font-medium text-emerald-800">Planned income</span><span class="ta-number"><%= number_to_currency(week.income) %></span></div>
                  <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-emerald-500" style="width: <%= income_width %>%"></div></div>
                </div>
                <div>
                  <div class="flex justify-between gap-2 text-xs"><span class="font-medium text-rose-800">Planned commitments</span><span class="ta-number"><%= number_to_currency(week.outflow) %></span></div>
                  <div class="mt-1 h-2 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-rose-500" style="width: <%= outflow_width %>%"></div></div>
                </div>
                <% if week.transfer.positive? %><p class="text-xs font-medium text-sky-800">Planned transfers: <span class="ta-number"><%= number_to_currency(week.transfer) %></span></p><% end %>
              </div>
            </article>
          <% end %>
        </div>

        <div class="overflow-x-auto border-t border-slate-200">
          <table class="ta-table">
            <caption class="sr-only">Exact upcoming recurring commitment dates, types, accounts, amounts, and materialization state.</caption>
            <thead class="ta-table-head"><tr><th class="ta-th">Date</th><th class="ta-th">Recurring item</th><th class="ta-th">Type</th><th class="ta-th">Account path</th><th class="ta-th">Month state</th><th class="ta-th text-right">Planned amount</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              <% @upcoming_commitments.rows.each do |row| %>
                <tr>
                  <td class="ta-td"><%= l(row.scheduled_on, format: :long) %></td>
                  <td class="ta-td font-medium text-slate-900"><%= row.name %></td>
                  <td class="ta-td"><%= row.kind.humanize %> · <%= row.flow_kind.humanize %></td>
                  <td class="ta-td"><%= [row.source_account&.name, row.destination_account&.name].compact.join(" → ").presence || "No linked account" %></td>
                  <td class="ta-td"><span class="ta-status-badge <%= row.materialized ? "bg-emerald-100 text-emerald-800" : "bg-slate-100 text-slate-700" %>"><%= row.materialized ? "Added to month" : "Upcoming" %></span></td>
                  <td class="ta-td ta-number text-right font-semibold"><%= number_to_currency(row.amount) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="border-t border-dashed border-slate-200 px-5 py-8 text-center">
          <p class="font-semibold text-slate-900">No target commitments in the next 90 days</p>
          <p class="mt-2 text-sm text-slate-600">Add or activate a recurring item to build the outlook. No sample financial data is shown.</p>
        </div>
      <% end %>
    </section>
  <% end %>

  <% recurring_groups.each do |group| %>
    <div
      data-tabs-target="panel"
      data-panel-name="<%= group[:anchor] %>"
      role="tabpanel"
      class="<%= group[:anchor] == default_recurring_section ? 'space-y-3' : 'hidden space-y-3' %>"
      <%= %(style="view-transition-name: recurring-template-panel; view-transition-class: ta-vt-panel;") if group[:anchor] == default_recurring_section %>>
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm text-slate-600">
        <span class="inline-flex items-center gap-2 font-medium text-slate-800">
          <%= tabler_icon(group[:icon], classes: "h-4 w-4 #{group[:icon_classes]}") %>
          <span><%= group[:description] %></span>
        </span>
        <span class="text-xs font-semibold text-slate-500"><%= group[:records].any? ? "#{group[:active_count]} active of #{group[:records].size}" : group[:empty_hint] %></span>
      </div>

      <% case group[:anchor] %>
      <% when "pay-schedules" %>
        <%= render "pay_schedules/section",
                   budget_month: nil,
                   return_to: planning_templates_path(anchor: "pay-schedules"),
                   pay_schedules: @pay_schedules,
                   pay_schedule: @pay_schedule %>
      <% when "subscriptions" %>
        <%= render "subscriptions/section",
                   budget_month: nil,
                   return_to: planning_templates_path(anchor: "subscriptions"),
                   subscriptions: @subscriptions,
                   subscription: @subscription %>
      <% when "monthly-bills" %>
        <%= render "monthly_bills/section",
                   budget_month: nil,
                   return_to: planning_templates_path(anchor: "monthly-bills"),
                   monthly_bills: @monthly_bills,
                   monthly_bill: @monthly_bill %>
      <% when "payment-plans" %>
        <%= render "payment_plans/section",
                   budget_month: nil,
                   return_to: planning_templates_path(anchor: "payment-plans"),
                   payment_plans: @payment_plans,
                   payment_plan: @payment_plan %>
      <% when "credit-cards" %>
        <%= render "credit_cards/section",
                   budget_month: nil,
                   return_to: planning_templates_path(anchor: "credit-cards"),
                   credit_cards: @credit_cards,
                   credit_card: @credit_card %>
      <% end %>
    </div>
  <% end %>
</div>
