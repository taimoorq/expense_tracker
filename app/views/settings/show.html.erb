<% content_for :title, "Settings" %>
<% breadcrumb "Settings" %>

<% page_header title: "Settings",
  eyebrow: "Preferences",
  subtitle: "Choose how the app opens, how month workspaces behave, and which visual theme you use.",
  icon: "settings" do %>
  <div class="rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm text-slate-600">
    <p><span class="font-semibold text-slate-900">Theme:</span> <%= current_theme.name %></p>
    <% if latest_release.present? %>
      <%= link_to "#{latest_release.label} release notes", help_releases_path, class: "mt-1 inline-flex font-medium text-indigo-600 hover:text-indigo-700" %>
    <% end %>
  </div>
<% end %>

<div class="space-y-6">
  <section class="ta-section-frame p-5">
    <div class="max-w-xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Workflow</p>
      <h2 class="mt-2 inline-flex items-center gap-2 text-lg font-semibold text-slate-900">
        <%= tabler_icon("home", classes: "h-5 w-5 text-indigo-600") %>
        <span>Default navigation preferences</span>
      </h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Choose where to land after signing in, which month view should open first, and what kind of financial rhythm the Overview guidance should assume.</p>
    </div>

    <%= form_with model: current_user, url: settings_path, method: :patch, class: "mt-5 space-y-5" do |form| %>
      <div class="grid gap-5 lg:grid-cols-3">
        <div>
          <%= form.label :default_landing_page, "Default landing page", class: "fb-label" %>
          <%= form.select :default_landing_page, options_for_select(landing_page_options, current_user.default_landing_page), {}, class: "fb-select" %>
          <p class="mt-2 text-sm text-slate-500">Used after a normal sign-in when there is no stored redirect.</p>
        </div>

        <div>
          <%= form.label :preferred_month_view, "Preferred month view", class: "fb-label" %>
          <%= form.select :preferred_month_view, options_for_select(preferred_month_view_options, current_user.preferred_month_view), {}, class: "fb-select" %>
          <p class="mt-2 text-sm text-slate-500">This becomes the default tab on month pages unless a specific tab is requested.</p>
        </div>

        <div>
          <%= form.label :financial_rhythm, "Financial rhythm", class: "fb-label" %>
          <%= form.select :financial_rhythm, options_for_select(financial_rhythm_options, current_user.financial_rhythm), {}, class: "fb-select" %>
          <p class="mt-2 text-sm text-slate-500">Used for lightweight Overview guidance. It does not change your entries, accounts, or calculations.</p>
        </div>
      </div>

      <%= form.button type: :submit, class: "fb-btn-primary ta-action-btn" do %>
        <%= tabler_icon("check", classes: "ta-action-icon") %>
        <span>Save settings</span>
      <% end %>
    <% end %>
  </section>

  <section class="ta-section-frame p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Getting started</p>
        <h2 class="mt-2 text-lg font-semibold text-slate-900">Financial setup checklist</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">The Home checklist derives progress from your accounts, recurring transactions, month, and review work. Hiding it does not change financial data.</p>
      </div>
      <% if @onboarding_membership.onboarding_dismissed_at.present? %>
        <%= button_to "Show checklist on Home", onboarding_preference_path,
          method: :patch,
          params: { dismissed: false },
          class: "fb-btn-secondary ta-action-btn shrink-0" %>
      <% elsif @onboarding_membership.onboarding_completed_at.present? %>
        <span class="ta-status-badge bg-emerald-100 text-emerald-800">Complete</span>
      <% else %>
        <span class="ta-status-badge bg-indigo-100 text-indigo-800">Shown on Home</span>
      <% end %>
    </div>
  </section>

  <section class="ta-section-frame p-5">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Color Scheme</p>
        <h2 class="mt-2 inline-flex items-center gap-2 text-lg font-semibold text-slate-900">
          <%= tabler_icon("sparkles", classes: "h-5 w-5 text-indigo-600") %>
          <span>Choose your palette</span>
        </h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">The active theme updates the app shell and the authentication pages. Your selection is saved for this browser.</p>
      </div>

      <div class="ta-settings-panel">
        <%= render "shared/theme_picker" %>
      </div>
    </div>
  </section>

  <section class="ta-section-frame p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Data and privacy</p>
        <h2 class="mt-2 inline-flex items-center gap-2 text-lg font-semibold text-slate-900"><%= tabler_icon("shield-lock", classes: "h-5 w-5 text-indigo-600") %><span>Backup and restore</span></h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Export a portable backup or preview a restore before it changes any saved financial data.</p>
      </div>
      <%= link_to backup_restore_path, class: "fb-btn-secondary ta-action-btn shrink-0" do %><span>Manage data</span><%= tabler_icon("arrow-right", classes: "ta-action-icon") %><% end %>
    </div>
  </section>

  <section class="ta-section-frame p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">More</p>
        <h2 class="mt-2 text-lg font-semibold text-slate-900">Reports and help</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">Review longer-term patterns or get guidance without crowding the daily navigation.</p>
      </div>
      <div class="flex flex-wrap gap-2"><%= link_to "Reports", reports_path, class: "fb-btn-secondary ta-action-btn" %><%= link_to "Help", help_path, class: "fb-btn-secondary ta-action-btn" %></div>
    </div>
  </section>
</div>
