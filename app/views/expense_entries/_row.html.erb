<% reason_for_entry = entry.category.presence || entry.section.humanize %>
<% timeline_view = local_assigns[:timeline_view] %>
<% selected_review = local_assigns[:selected_review] %>
<tr id="<%= dom_id(entry) %>"
  data-expense-entries-filter-target="row"
  data-date="<%= entry.occurred_on&.iso8601 %>"
  data-payee="<%= entry.payee.to_s %>"
  data-reason="<%= reason_for_entry.to_s %>"
  data-value="<%= reason_for_entry.to_s.downcase %>"
  data-account="<%= entry.account_name.to_s %>"
  data-status="<%= entry.status %>"
  data-sortable-table-target="row"
  data-sort-date-value="<%= entry.occurred_on&.iso8601 %>"
  data-sort-section-value="<%= entry.section.humanize %>"
  data-sort-category-value="<%= entry.category.to_s %>"
  data-sort-payee-value="<%= entry.payee.to_s %>"
  data-sort-account-value="<%= entry.account_name.to_s %>"
  data-sort-planned-value="<%= entry.planned_amount %>"
  data-sort-actual-value="<%= entry.actual_amount %>"
  data-sort-status-value="<%= entry.status.humanize %>"
  style="view-transition-name: table-entry-<%= dom_id(entry) %>; view-transition-class: ta-vt-row;">
  <td class="px-3 py-2"><%= entry.occurred_on %></td>
  <td class="px-3 py-2"><%= entry.section.humanize %></td>
  <td class="px-3 py-2"><%= entry.category %></td>
  <td class="px-3 py-2"><%= entry.payee %></td>
  <td class="px-3 py-2 hidden lg:table-cell"><%= entry.account_name.presence || "—" %></td>
  <td class="px-3 py-2 text-right"><%= number_to_currency(entry.planned_amount || 0) %></td>
  <td class="px-3 py-2 text-right"><%= number_to_currency(entry.actual_amount || 0) %></td>
  <td class="px-3 py-2"><%= entry.status.humanize %></td>
  <td class="px-3 py-2">
    <%= render "expense_entries/row_actions", budget_month: budget_month, entry: entry, timeline_view: timeline_view, selected_review: selected_review, read_only: local_assigns[:read_only] %>
  </td>
  <% if local_assigns[:running_balances] %>
    <%= render "expense_entries/balance_cell", entry: entry, balance: running_balances.fetch(entry.id) %>
  <% end %>
</tr>
