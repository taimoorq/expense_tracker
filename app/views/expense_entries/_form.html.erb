<%= turbo_frame_tag "entry_form" do %>
  <section class="mb-6 rounded-[24px] border border-slate-200 bg-white/85 p-5 shadow-sm">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="ta-ledger-rail max-w-2xl">
        <p class="ta-page-eyebrow">One place for every month entry</p>
        <h3 class="ta-section-title mt-1">Add an entry</h3>
        <p class="mt-1 text-sm leading-6 text-slate-600">Add a one-time item, start from something recurring, or save a new recurring item in the same focused form.</p>
      </div>

      <%= link_to new_wizard_budget_month_expense_entries_path(budget_month, timeline_view: local_assigns[:timeline_view]),
                  class: "fb-btn-primary ta-action-btn shrink-0",
                  data: { turbo_frame: "entry_wizard_modal" } do %>
        <%= tabler_icon("plus", classes: "h-4 w-4") %>
        <span>Add entry</span>
      <% end %>
    </div>
  </section>
<% end %>
