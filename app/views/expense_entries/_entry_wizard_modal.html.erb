<%= turbo_frame_tag "entry_wizard_modal" do %>
  <div class="ta-dialog-backdrop" data-controller="template-modal" data-template-modal-allow-backdrop-close-value="false" data-action="keydown.esc@window->template-modal#close keydown@window->template-modal#trapFocus">
    <div class="ta-dialog max-w-5xl" role="dialog" aria-modal="true" aria-labelledby="entry-composer-title" aria-describedby="entry-composer-description" tabindex="-1" data-template-modal-target="dialog">
      <div class="ta-dialog-header">
        <div class="ta-ledger-rail">
          <p class="ta-page-eyebrow inline-flex items-center gap-2"><%= tabler_icon("plus", classes: "h-3.5 w-3.5") %> <%= budget_month.label %></p>
          <h2 id="entry-composer-title" class="ta-dialog-title">Add entry</h2>
          <p id="entry-composer-description" class="ta-dialog-description">Add it once, start from something recurring, or make it repeat—without leaving the month.</p>
        </div>
        <button type="button" class="ta-icon-btn" aria-label="Close add entry" title="Close" data-action="click->template-modal#close">
          <%= tabler_icon("x", classes: "h-4 w-4") %>
        </button>
      </div>

      <%= render "expense_entries/entry_composer_form", budget_month: budget_month, expense_entry: expense_entry, modal: true %>
    </div>
  </div>
<% end %>
