<% content_for :title, "Import Account Activity" %>
<% breadcrumb "Accounts", accounts_path %>
<% breadcrumb @account.name, account_path(@account) %>
<% breadcrumb "Import Activity" %>
<% page_header title: "Import Account Activity", subtitle: @account.name, icon: "upload" %>

<div class="mx-auto max-w-3xl space-y-5">
  <section class="ta-section-frame p-5">
    <h2 class="ta-section-title">Choose your activity file</h2>
    <p class="ta-muted mt-2">Upload the CSV export from <%= @account.institution_name.presence || @account.name %>. You’ll review the rows and any balance changes before saving.</p>
    <% if @import_history.recommended_start_on %>
      <p class="ta-muted mt-3">For your next export, include <strong><%= l(@import_history.recommended_start_on, format: :long) %></strong> again. Exact duplicates will be skipped.</p>
    <% end %>
    <%= form_with url: preview_account_account_activity_imports_path(@account), method: :post, multipart: true,
      class: "mt-5 space-y-4", data: { controller: "turbo-submit", turbo: false,
        action: "submit->turbo-submit#submitStart turbo:submit-start->turbo-submit#submitStart turbo:submit-end->turbo-submit#submitEnd",
        turbo_submit_default_label_value: "Preview Institution Activity", turbo_submit_pending_label_value: "Building preview…" } do |form| %>
      <div>
        <%= form.label :file, "Institution CSV export", class: "fb-label" %>
        <%= form.file_field :file, accept: ".csv", required: true, class: "fb-input" %>
      </div>
      <p class="hidden ta-muted" data-turbo-submit-target="status" aria-live="polite" aria-hidden="true">Reading your file and checking for duplicates…</p>
      <div class="flex flex-wrap items-center gap-3">
        <%= button_tag type: :submit, class: "fb-btn-primary", data: { turbo_submit_target: "submitButton" } do %>
          <span data-turbo-submit-target="submitLabel">Preview Institution Activity</span>
        <% end %>
        <%= link_to "Cancel", account_path(@account), class: "fb-btn-secondary" %>
      </div>
    <% end %>
  </section>
  <details class="ta-section-frame ta-account-disclosure">
    <summary>Import history</summary>
    <div class="ta-disclosure-body"><%= render "account_activity_imports/history", history: @import_history, account: @account, show_import_action: false %></div>
  </details>
</div>
