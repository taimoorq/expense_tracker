<%# locals: (history:, account:, show_import_action: true) %>
<section id="import-history" class="ta-section-frame" aria-labelledby="import-history-title">
  <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
    <div class="ta-ledger-rail">
      <p class="ta-page-eyebrow">Import log</p>
      <h2 id="import-history-title" class="ta-section-title mt-1">What has already been imported</h2>
      <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">Each confirmed file records when it was imported, the transaction dates it covered, and how many rows were added or skipped.</p>
    </div>
    <% if show_import_action %>
      <%= link_to new_account_account_activity_import_path(account), class: "fb-btn-secondary ta-action-btn" do %>
        <%= tabler_icon("upload", classes: "ta-action-icon text-slate-600") %>
        <span>Import another file</span>
      <% end %>
    <% end %>
  </div>

  <% if history.latest_import %>
    <% latest = history.latest_import %>
    <div class="grid gap-0 border-t border-slate-200 bg-slate-50/70 md:grid-cols-2">
      <div class="p-4 sm:p-5">
        <p class="ta-ledger-label">Last completed import</p>
        <p class="mt-2 text-sm font-semibold text-slate-900">
          <time datetime="<%= latest.imported_at.iso8601 %>"><%= l(latest.imported_at, format: :long) %></time>
        </p>
        <p class="mt-1 truncate text-xs text-slate-600"><%= latest.original_filename %></p>
      </div>
      <div class="border-t border-slate-200 p-4 sm:p-5 md:border-l md:border-t-0">
        <p class="ta-ledger-label">Safest next export start</p>
        <% if history.recommended_start_on %>
          <p class="mt-2 text-sm font-semibold text-slate-900"><%= l(history.recommended_start_on, format: :long) %></p>
          <p class="mt-1 text-xs leading-5 text-slate-600">Include the last covered day again. Exact rows already saved will be skipped as duplicates.</p>
        <% else %>
          <p class="mt-2 text-sm font-semibold text-slate-900">Review the institution export range</p>
          <p class="mt-1 text-xs leading-5 text-slate-600">The last file did not expose a complete transaction-date range.</p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if history.any? %>
    <div class="overflow-x-auto border-t border-slate-200">
      <table class="min-w-full text-left text-sm">
        <caption class="sr-only">Import history with completion time, file, covered dates, and row results</caption>
        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
          <tr>
            <th scope="col" class="px-4 py-3 sm:px-5">Imported</th>
            <th scope="col" class="px-4 py-3">File</th>
            <th scope="col" class="px-4 py-3">Transaction dates covered</th>
            <th scope="col" class="px-4 py-3 text-right sm:px-5">Result</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          <% history.imports.each do |activity_import| %>
            <tr id="<%= dom_id(activity_import) %>">
              <td class="whitespace-nowrap px-4 py-3 text-slate-700 sm:px-5">
                <time datetime="<%= activity_import.imported_at.iso8601 %>"><%= l(activity_import.imported_at, format: :long) %></time>
              </td>
              <td class="max-w-64 px-4 py-3">
                <p class="truncate font-semibold text-slate-900"><%= activity_import.original_filename %></p>
                <% if activity_import.institution_name.present? %><p class="mt-1 text-xs text-slate-500"><%= activity_import.institution_name %></p><% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-slate-700">
                <% if activity_import.started_on && activity_import.ended_on %>
                  <% if activity_import.started_on == activity_import.ended_on %>
                    <%= l(activity_import.started_on, format: :long) %>
                  <% else %>
                    <%= l(activity_import.started_on, format: :long) %> – <%= l(activity_import.ended_on, format: :long) %>
                  <% end %>
                <% else %>
                  <span class="text-slate-500">Not detected</span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-4 py-3 text-right text-slate-700 sm:px-5">
                <span class="font-semibold text-slate-900"><%= pluralize(activity_import.imported_count, "row") %> added</span>
                <span class="block text-xs text-slate-500"><%= pluralize(activity_import.duplicate_count, "duplicate") %> skipped<%= activity_import.warning_messages.any? ? " · #{pluralize(activity_import.warning_messages.size, 'warning')}" : "" %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if history.limited %><p class="border-t border-slate-200 px-4 py-3 text-xs text-slate-500 sm:px-5">Showing the most recent <%= history.imports.size %> imports for this account.</p><% end %>
  <% else %>
    <div class="border-t border-slate-200 px-5 py-10 text-center">
      <h3 class="text-base font-semibold text-slate-900">No account files imported yet</h3>
      <p class="mx-auto mt-2 max-w-xl text-sm leading-6 text-slate-600">Your first confirmed import will appear here with its completion time, covered dates, and row counts.</p>
    </div>
  <% end %>
</section>
