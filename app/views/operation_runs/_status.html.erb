<section class="ta-section-frame" aria-labelledby="operation-status-title" aria-live="polite">
  <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="ta-page-eyebrow">Operation</p>
      <h2 id="operation-status-title" class="ta-section-title mt-1"><%= status.title %></h2>
      <p class="mt-1 text-sm leading-6 text-slate-600"><%= status.description %></p>
    </div>
    <span class="ta-status-badge <%= status.state_classes %>"><%= status.state_label %></span>
  </div>
  <div class="border-t border-slate-200 p-5">
    <% if status.progress_percent.present? %>
      <div role="progressbar" aria-label="<%= status.title %> progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= status.progress_percent %>">
        <div class="h-2 overflow-hidden rounded-full bg-slate-200"><div class="h-full rounded-full bg-indigo-600" style="width: <%= status.progress_percent %>%"></div></div>
      </div>
    <% elsif status.active? %>
      <div class="h-2 overflow-hidden rounded-full bg-slate-200" aria-label="Progress is still being measured"><div class="h-full w-1/3 animate-pulse rounded-full bg-indigo-500 motion-reduce:animate-none"></div></div>
    <% end %>
    <p class="mt-3 text-sm text-slate-700"><%= status.progress_label %></p>
    <% if status.result_summary.present? %><p class="mt-2 text-sm font-semibold text-slate-900"><%= status.result_summary %></p><% end %>
    <% if status.error_label.present? %><p class="mt-3 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-900"><%= status.error_label %></p><% end %>
    <dl class="mt-5 grid gap-3 border-t border-slate-200 pt-4 text-sm sm:grid-cols-2">
      <div><dt class="ta-ledger-label">Support reference</dt><dd class="ta-number mt-1 font-semibold text-slate-900"><%= status.support_reference %></dd></div>
      <div><dt class="ta-ledger-label">Last state change</dt><dd class="mt-1 text-slate-700"><%= l(status.completed_at || status.started_at || Time.current, format: :long) %></dd></div>
    </dl>
    <div class="mt-5 flex flex-wrap gap-3"><%= link_to "Back to Home", root_path, class: "fb-btn-secondary ta-action-btn" %><% if status.state == "failed" && status.retryable %><span class="text-sm text-slate-600">Return to the original import, restore, or month screen to retry safely.</span><% end %></div>
  </div>
</section>
