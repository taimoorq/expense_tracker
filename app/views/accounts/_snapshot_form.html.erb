<% compact = local_assigns.fetch(:compact, false) %>
<%= form_with model: [account, account_snapshot],
  namespace: local_assigns[:form_namespace],
  class: compact ? "space-y-3" : "space-y-4",
  aria: (local_assigns[:labelledby].present? ? { labelledby: local_assigns[:labelledby] } : {}) do |form| %>
  <% if account_snapshot.errors.any? %>
    <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
      <p class="font-semibold">Fix the snapshot details.</p>
      <ul class="mt-2 space-y-1">
        <% account_snapshot.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid <%= compact ? "gap-3 sm:grid-cols-2" : "gap-4 md:grid-cols-2" %>">
    <div>
      <%= form.label :balance_date, "Balance date", class: "fb-label" %>
      <%= form.date_field :balance_date, class: "fb-input" %>
    </div>

    <div>
      <%= form.label :balance_timing, "Balance timing", class: "fb-label" %>
      <%= form.select :balance_timing, [["Opening (before transactions)", "opening"], ["Closing (after transactions)", "closing"]], {}, class: "fb-select" %>
      <p class="mt-1 text-xs text-slate-500">For a month’s starting balance, choose Opening and the first of the month. Opening balances appear in history through the previous day.</p>
    </div>

    <div>
      <%= form.label :balance, class: "fb-label" %>
      <%= form.number_field :balance, step: "0.01", class: "fb-input", placeholder: account.liability? ? "-4500.00" : "15000.00" %>
      <p class="mt-1 text-xs text-slate-500"><%= account.liability? ? "Use a negative balance for liabilities." : "Enter the total account value for this date." %></p>
    </div>

  </div>
  <details class="ta-account-disclosure" <%= "open" if account_snapshot.available_balance.present? || account_snapshot.notes.present? || account_snapshot.errors.any? %>>
    <summary>Available balance and notes</summary>
    <div class="space-y-3 px-1 pb-3">
      <div>
        <%= form.label :available_balance, class: "fb-label" %>
        <%= form.number_field :available_balance, step: "0.01", class: "fb-input", placeholder: "Optional" %>
      </div>
      <div>
        <%= form.label :notes, class: "fb-label" %>
        <%= form.text_area :notes, rows: 2, class: "fb-input", placeholder: "Optional note about this balance" %>
      </div>
    </div>
  </details>

  <div class="flex flex-wrap items-center gap-3">
    <%= form.submit(account_snapshot.persisted? ? "Update Balance" : "Record Balance", class: "fb-btn-primary") %>
    <% if local_assigns[:cancel_path].present? %>
      <%= link_to local_assigns[:cancel_path], class: "fb-btn-secondary ta-action-btn" do %>
        <%= tabler_icon("x", classes: "ta-action-icon text-slate-600") %>
        <span>Cancel</span>
      <% end %>
    <% elsif account_snapshot.persisted? %>
      <%= link_to account_path(account, view: "manage"), class: "fb-btn-secondary ta-action-btn" do %>
        <%= tabler_icon("arrow-left", classes: "ta-action-icon text-slate-600") %>
        <span>Back to Account</span>
      <% end %>
    <% end %>
  </div>
<% end %>
