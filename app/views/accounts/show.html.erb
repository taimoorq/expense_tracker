<% content_for :title, @account.name %>
<% breadcrumb "Accounts", accounts_path %>
<% breadcrumb @account.name %>

<% content_for :head do %>
  <%= chart_library_tags %>
<% end %>

<% page_header title: @account.name,
  eyebrow: @account.kind.humanize,
  subtitle: @account.institution_name.presence || "Manual account",
  icon: "building-library" do %>
    <%= render "accounts/detail_actions", account: @account %>
<% end %>

<%= render "accounts/account_navigation", account: @account, active_view: @account_view, range: params[:range].presence %>

<%= render "accounts/#{@account_view}", account: @account %>
