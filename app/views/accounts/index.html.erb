<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% content_for :title, "Accounts" %>
<% breadcrumb "Accounts" %>
<% content_for :head do %><%= chart_library_tags %><% end %>

<% page_header title: "Accounts", subtitle: "Your balances, in one place.", icon: "credit-card" do %>
  <%= link_to "Bank connections", bank_connections_path, class: "fb-btn-secondary" %>
  <%= link_to "New Account", new_account_path, class: "fb-btn-primary" %>
<% end %>

<div class="space-y-6">
  <% if @accounts.any? %>
    <section id="accounts-summary" class="ta-section-frame" aria-label="Net worth summary">
      <dl class="ta-account-metrics ta-account-metrics-primary">
        <div>
          <dt class="ta-account-column-label"><%= @net_worth_complete ? "Net Worth" : "Known balance subtotal" %></dt>
          <dd class="ta-account-total"><%= number_to_currency(@net_worth_total) %></dd>
          <dd class="ta-muted mt-1"><%= @net_worth_coverage_count %> of <%= pluralize(@net_worth_accounts.count, "account") %> included with a balance</dd>
        </div>
        <div><dt class="ta-account-column-label">Assets</dt><dd class="ta-account-total"><%= number_to_currency(@assets_total) %></dd></div>
        <div><dt class="ta-account-column-label">Liabilities</dt><dd class="ta-account-total"><%= number_to_currency(@liabilities_total) %></dd></div>
      </dl>
      <% unless @net_worth_complete %>
        <p class="ta-account-coverage">This subtotal is incomplete. Add a source for the unresolved accounts below to see your full net worth.</p>
      <% end %>
    </section>
  <% end %>

  <%= render "accounts/tracked_accounts" %>
  <% if @accounts.any? %><%= render "accounts/net_worth_history" %><% end %>

  <details class="ta-section-frame ta-account-disclosure" id="account-balance-help">
    <summary>How account balances work</summary>
    <div class="ta-disclosure-body space-y-3 text-sm">
      <p>Use a reviewed bank balance, an institution import, or a manual snapshot as your starting point. Recorded activity updates the app balance; planned activity appears only in projections.</p>
      <p>Net worth is assets minus liabilities for the accounts you include. Missing balances remain unresolved rather than counting as zero.</p>
      <p>Use negative balances for debts. Bank balances show the bank’s report and may differ from the app estimate until you review recorded payments and activity.</p>
      <% if @latest_balance_source %>
        <% latest_date = @latest_balance_source.activity_through_on || @latest_balance_source.balance_source_recorded_on %>
        <p class="ta-muted">Latest trusted source: <%= @latest_balance_source.account.name %> · <%= @latest_balance_source.balance_source_label %> · <%= l(latest_date, format: :long) %>.</p>
      <% end %>
      <%= link_to "Read the account guide", help_path(anchor: "accounts"), class: "ta-account-next-action" %>
    </div>
  </details>
</div>
