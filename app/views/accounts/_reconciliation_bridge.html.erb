<% liability = account.liability? %>
<% movement_label = liability ? "Charges minus payments" : "Money in minus money out" %>
<% baseline_label = liability ? "Baseline debt" : "Trusted starting balance" %>
<% current_label = liability ? "Calculated debt" : "Calculated balance" %>

<section class="ta-section-frame overflow-hidden" aria-labelledby="reconciliation-title">
  <div class="ta-section-header flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="ta-page-eyebrow">Reconciliation</p>
      <h2 id="reconciliation-title" class="ta-section-title mt-1">Why this balance is <%= number_to_currency(bridge[:current_balance]) %></h2>
      <p class="mt-1 text-sm text-slate-600">One trusted observation plus every later canonical posting. No planned amount is included.</p>
    </div>
    <span class="ta-status-badge <%= bridge[:reconciled] ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800" %>"><%= bridge[:reconciled] ? "Reconciled" : "Review difference" %></span>
  </div>

  <div class="grid border-t border-slate-200 sm:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr] sm:items-stretch">
    <article class="p-4">
      <p class="ta-ledger-label"><%= baseline_label %></p>
      <p class="ta-number mt-2 text-xl font-semibold text-slate-900"><%= number_to_currency(bridge[:baseline_balance]) %></p>
      <p class="mt-1 text-xs text-slate-500"><%= bridge[:baseline_label] %> on <%= l(bridge[:baseline_on], format: :long) %></p>
    </article>
    <div class="hidden items-center text-xl text-slate-400 sm:flex" aria-hidden="true">+</div>
    <article class="border-t border-slate-200 p-4 sm:border-t-0">
      <p class="ta-ledger-label"><%= liability ? "Charges" : "Money in" %></p>
      <p class="ta-number mt-2 text-xl font-semibold text-rose-700"><%= number_to_currency(liability ? bridge[:outgoing] : bridge[:incoming]) %></p>
      <%= link_to "View records", activity_path(view: "all", account_id: account.id, starts_on: bridge[:baseline_on].next_day, ends_on: bridge[:through_on], direction: liability ? "outgoing" : "incoming"), class: "mt-1 inline-flex text-xs font-semibold text-indigo-700 hover:text-indigo-600" %>
    </article>
    <div class="hidden items-center text-xl text-slate-400 sm:flex" aria-hidden="true">−</div>
    <article class="border-t border-slate-200 p-4 sm:border-t-0">
      <p class="ta-ledger-label"><%= liability ? "Payments and credits" : "Money out" %></p>
      <p class="ta-number mt-2 text-xl font-semibold text-emerald-700"><%= number_to_currency(liability ? bridge[:incoming] : bridge[:outgoing]) %></p>
      <%= link_to "View records", activity_path(view: "all", account_id: account.id, starts_on: bridge[:baseline_on].next_day, ends_on: bridge[:through_on], direction: liability ? "incoming" : "outgoing"), class: "mt-1 inline-flex text-xs font-semibold text-indigo-700 hover:text-indigo-600" %>
    </article>
    <div class="hidden items-center text-xl text-slate-400 sm:flex" aria-hidden="true">=</div>
    <article class="border-t border-indigo-100 bg-indigo-50/70 p-4 sm:border-t-0">
      <p class="ta-ledger-label"><%= current_label %></p>
      <p class="ta-number mt-2 text-xl font-semibold text-indigo-950"><%= number_to_currency(bridge[:current_balance]) %></p>
      <p class="mt-1 text-xs text-indigo-900/70"><%= pluralize(bridge[:transaction_count], "posted transaction") %> · <%= bridge[:calculation_version] %></p>
    </article>
  </div>
  <p class="sr-only"><%= baseline_label %> <%= number_to_currency(bridge[:baseline_balance]) %>; <%= movement_label %>: <%= number_to_currency(bridge[:incoming] - bridge[:outgoing]) %>; <%= current_label %> <%= number_to_currency(bridge[:current_balance]) %>.</p>
</section>
