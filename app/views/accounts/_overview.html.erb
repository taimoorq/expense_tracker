<% balance_available = @balance_summary.fetch(:balance_available) %>
<% evidence = @bank_evidence&.fetch(account.id, nil) %>
<% mapping, bank_balance = evidence&.values_at(:mapping, :balance) %>

<div class="space-y-5">
  <section class="ta-section-frame" aria-label="Account balances">
    <dl class="ta-account-metrics <%= 'ta-account-metrics-primary' if mapping %>">
      <div>
        <dt class="ta-account-column-label">App balance</dt>
        <dd class="ta-account-total"><%= balance_available ? number_to_currency(@balance_summary[:current_balance]) : "Needs source" %></dd>
        <dd class="ta-muted mt-1"><%= @balance_summary[:balance_source_label] %></dd>
        <% if @balance_summary[:balance_source_recorded_on] %><dd class="ta-account-meta">Source: <%= l(@balance_summary[:balance_source_recorded_on], format: :long) %></dd><% end %>
        <% if @balance_summary[:activity_through_on] %><dd class="ta-account-meta">Activity through <%= l(@balance_summary[:activity_through_on], format: :long) %></dd><% end %>
      </div>
      <div>
        <dt class="ta-account-column-label">Projected balance</dt>
        <dd class="ta-account-total"><%= balance_available ? number_to_currency(@balance_summary[:projected_balance]) : "—" %></dd>
        <dd class="ta-muted mt-1"><%= balance_available ? "Includes #{pluralize(@balance_summary[:planned_entries_count], 'planned entry')}." : "Add a starting balance to see a projection." %></dd>
      </div>
      <% if mapping %>
        <div>
          <dt class="ta-account-column-label">Bank balance</dt>
          <dd class="ta-account-total"><%= bank_balance ? number_to_currency(bank_balance.balance * mapping.sign_multiplier) : "Waiting for balance" %></dd>
          <dd class="ta-muted mt-1">SimpleFIN · <%= bank_account_connection_status(mapping) %></dd>
          <% if bank_balance %><dd class="ta-account-meta"><%= bank_timestamp(bank_balance.reported_at, mapping.budget_workspace) %></dd><% end %>
          <% if bank_balance&.stale? %><dd class="ta-account-notice">Stale balance</dd><% end %>
        </div>
      <% end %>
    </dl>
    <% unless balance_available %><p class="ta-account-coverage">Review a bank balance or record a manual balance to give this account a starting point.</p><% end %>
    <% if mapping && (mapping.error_message.present? || mapping.bank_connection.error_message.present?) %>
      <p class="ta-account-coverage"><%= mapping.error_message.presence || mapping.bank_connection.error_message %> <%= link_to "Check connection", bank_connection_path(mapping.bank_connection, anchor: dom_id(mapping)), class: "underline" %></p>
    <% end %>
  </section>

  <% reserved = account.payment_commitments.where(state: "reserved").includes(:payment_settlements).to_a %>
  <% if reserved.any? %><section class="ta-section-frame p-4"><h2 class="font-semibold">Payments reserved · <%= number_to_currency(reserved.sum(&:outstanding_amount)) %></h2><p class="ta-muted mt-1 text-sm">Recorded payments are waiting for clearing evidence. Their inclusion in a bank balance is reviewed separately.</p><%= link_to "Review payments clearing", activity_path(view: "payments", account_id: account.id), class: "mt-2 inline-flex underline" %></section><% end %>
  <%= render "accounts/recent_activity", account: account %>

  <details class="ta-section-frame ta-account-disclosure" id="balance-calculation" <%= "open" if @reconciliation_bridge && !@reconciliation_bridge[:reconciled] %>>
    <summary>How this balance is calculated<%= " · Review difference" if @reconciliation_bridge && !@reconciliation_bridge[:reconciled] %></summary>
    <div class="ta-disclosure-body space-y-4">
      <% if balance_available %>
        <dl class="grid gap-3 text-sm sm:grid-cols-3">
          <div><dt class="ta-muted">Starting balance</dt><dd class="ta-account-amount mt-1"><%= number_to_currency(@balance_summary[:base_balance]) %></dd></div>
          <div><dt class="ta-muted">Recorded activity</dt><dd class="ta-account-amount mt-1"><%= number_to_currency(@balance_summary[:paid_delta]) %></dd></div>
          <div><dt class="ta-muted">Planned impact</dt><dd class="ta-account-amount mt-1"><%= number_to_currency(@balance_summary[:planned_delta]) %></dd></div>
        </dl>
        <p class="ta-muted">Recorded activity updates the starting balance. Plans affect only the projected balance.</p>
      <% else %><p class="ta-muted">Your records are saved. A trusted starting balance is needed before they can resolve an app balance.</p><% end %>
      <%= render "accounts/bank_balance", evidence: evidence, account: account %>
      <% if @reconciliation_bridge %><%= render "accounts/reconciliation_bridge", account: account, bridge: @reconciliation_bridge %><% end %>
      <%= link_to "Review balance sources", account_path(account, view: "manage"), class: "ta-account-next-action" %>
    </div>
  </details>

  <details class="ta-section-frame ta-account-disclosure" id="account-movement" <%= "open" if params[:range].present? %>>
    <summary>Movement and history</summary>
    <div class="ta-disclosure-body space-y-5">
      <%= render "accounts/movement_timeline", account: account, story: @account_story, timeline: @movement_timeline %>
      <% if @credit_card_progress %><%= render "accounts/credit_card_progress", credit_card_progress: @credit_card_progress %><% end %>
    </div>
  </details>
</div>
