<details id="net-worth-history" class="ta-section-frame ta-account-disclosure">
  <summary>Net worth history</summary>
  <div class="ta-disclosure-body">
    <p class="ta-muted mb-4">Balances for accounts included in net worth. Open the exact values to check coverage for each date.</p>
        <% if @trend_labels.any? %>
          <div class="h-80 rounded-2xl border border-slate-200 bg-white p-3">
            <canvas
              data-controller="chart"
              data-chart-type-value="line"
              data-chart-title-value="Net Worth History"
              data-chart-labels-value="<%= @trend_labels.to_json %>"
              data-chart-data-value="<%= @trend_values.to_json %>"></canvas>
          </div>
        <% else %>
          <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center">
            <p class="text-lg font-semibold text-slate-900">No trend yet</p>
            <p class="mt-2 text-sm text-slate-500">Record balance snapshots to build a net worth history chart.</p>
          </div>
        <% end %>
        <% if @trend_rows.any? %>
          <details class="mt-4 rounded-xl border border-slate-200 bg-white">
            <summary class="cursor-pointer px-4 py-3 text-sm font-semibold text-slate-800">Review exact net worth history</summary>
            <div class="overflow-x-auto border-t border-slate-100">
              <table class="min-w-full text-sm">
                <caption class="sr-only">Exact values and account coverage for the net worth history graph</caption>
                <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500"><tr><th scope="col" class="px-4 py-3">Date</th><th scope="col" class="px-4 py-3 text-right">Net Worth</th><th scope="col" class="px-4 py-3 text-right">Coverage</th></tr></thead>
                <tbody class="divide-y divide-slate-100">
                  <% @trend_rows.reverse_each do |row| %>
                    <tr><th scope="row" class="px-4 py-3 text-left font-medium text-slate-900"><%= row[:label] %></th><td class="ta-money px-4 py-3 text-right text-slate-700"><%= row[:complete] ? number_to_currency(row[:value]) : "Insufficient coverage" %></td><td class="px-4 py-3 text-right text-slate-600"><%= row[:coverage_count] %> of <%= row[:account_count] %> accounts</td></tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </details>
        <% end %>
  </div>
</details>
