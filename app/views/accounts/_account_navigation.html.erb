<nav class="mb-6 overflow-x-auto rounded-[var(--ta-radius-md)] border border-slate-200 bg-white p-2 shadow-[var(--ta-shadow-low)]" aria-label="Account information">
  <div class="ta-tab-list min-w-max">
    <% {
      "overview" => ["layout-dashboard", "Overview"],
      "activity" => ["list-details", "Activity"],
      "insights" => ["bulb", "Insights"],
      "manage" => ["settings-2", "Manage"]
    }.each do |view, (icon, label)| %>
      <% destination = if view == "activity" && account.budget_workspace&.target_reads_enabled?
        activity_path(view: "all", account_id: account.id)
      else
        account_path(account, view: view, range: range)
      end %>
      <%= link_to destination,
                  class: "ta-tab #{'ta-tab-active' if active_view == view}",
                  aria: { current: ("page" if active_view == view), selected: (active_view == view).to_s } do %>
        <span class="inline-flex items-center gap-2">
          <%= tabler_icon(icon, classes: "ta-tab-icon") %>
          <span><%= label %></span>
        </span>
      <% end %>
    <% end %>
  </div>
</nav>
