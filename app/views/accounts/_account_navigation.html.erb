<nav class="ta-account-nav" aria-label="Account information">
  <% { "overview" => "Overview", "activity" => "Activity", "insights" => "Insights", "manage" => "Manage" }.each do |view, label| %>
    <% destination = if view == "activity" && account.budget_workspace&.target_reads_enabled?
      activity_path(view: "all", account_id: account.id)
    else
      account_path(account, view: view, range: range)
    end %>
    <%= link_to label, destination, aria: { current: ("page" if active_view == view) } %>
  <% end %>
</nav>
