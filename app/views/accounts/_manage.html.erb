<% persisted_snapshots = account.account_snapshots.select(&:persisted?).sort_by { |snapshot| [snapshot.recorded_on, snapshot.created_at] }.reverse %>
<div class="space-y-5">
  <section class="ta-section-frame p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="ta-section-title">Account settings</h2>
      <%= link_to "Edit account", edit_account_path(account), class: "ta-account-next-action" %>
    </div>
    <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-3">
      <div><dt class="ta-muted">Net worth</dt><dd class="mt-1"><%= account.include_in_net_worth? ? "Included" : "Excluded" %></dd></div>
      <div><dt class="ta-muted">Cash totals</dt><dd class="mt-1"><%= account.include_in_cash? ? "Included" : "Excluded" %></dd></div>
      <div><dt class="ta-muted">Status</dt><dd class="mt-1"><%= account.active? ? "Active" : "Inactive" %></dd></div>
    </dl>
    <% if account.notes.present? %><p class="ta-muted mt-4"><%= account.notes %></p><% end %>
  </section>

  <details id="record-balance" class="ta-section-frame ta-account-disclosure" <%= "open" if @account_snapshot.errors.any? || !@balance_summary.fetch(:balance_available) %>>
    <summary>Record a manual balance</summary>
    <div class="ta-disclosure-body">
      <p class="ta-muted mb-4">Save the balance you checked for a specific date. This can change later app balances and projections.</p>
      <%= render "accounts/snapshot_form", account: account, account_snapshot: @account_snapshot %>
    </div>
  </details>

  <details id="manual-snapshots" class="ta-section-frame ta-account-disclosure" <%= "open" if flash[:notice].to_s.start_with?("Balance snapshot") %>>
    <summary>Manual snapshots · <%= persisted_snapshots.size %></summary>
    <div class="ta-disclosure-body"><%= render "accounts/snapshot_history", account: account, persisted_snapshots: persisted_snapshots %></div>
  </details>

  <details class="ta-section-frame ta-account-disclosure">
    <summary>Monthly balance history</summary>
    <div class="ta-disclosure-body"><%= render "accounts/balance_history", account: account %></div>
  </details>

  <details class="ta-section-frame ta-account-disclosure">
    <summary>Connected recurring templates · <%= @connected_templates_count %></summary>
    <div class="ta-disclosure-body"><%= render "accounts/connected_templates", account: account %></div>
  </details>

  <details class="ta-section-frame ta-account-disclosure">
    <summary>Import history</summary>
    <div class="ta-disclosure-body"><%= render "account_activity_imports/history", history: @import_history, account: account, show_import_action: true %></div>
  </details>
</div>
