# Copy this file to .env for local development or local Docker overrides.
# Example:
#   cp .env.example .env

# Docker host port override
APP_PORT=4287

# Local Rails server port
PORT=3000

# Puma / Active Record thread pool size
RAILS_MAX_THREADS=5

# Optional local PostgreSQL connection string.
# Uncomment and adjust if you prefer an explicit TCP connection instead of the
# default local socket-based PostgreSQL setup in config/database.yml.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/expense_tracker_development

# Optional seed overrides for the demo user created by bin/rails db:seed
# SEED_MODE supports:
# - users
# - users_with_transactions
SEED_MODE=users
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=password123!

# Optional install-time admin bootstrap. If both values are present, bin/setup,
# the Docker entrypoint, and bin/rails admin:bootstrap will create or update the
# separate administrator account automatically.
# ADMIN_USER_EMAIL=admin@example.com
# ADMIN_USER_PASSWORD=change-me

# Optional production/self-hosted setting used when running jobs inside Puma.
# Not typically needed for local development.
# SOLID_QUEUE_IN_PUMA=true

# Optional automatic workspace backups. Generate BACKUP_ENCRYPTION_KEY with
# `openssl rand -base64 32`, then change the driver to local or s3.
# BACKUP_STORAGE_DRIVER=disabled
# BACKUP_HOST_PATH=./backups
# BACKUP_LOCAL_ROOT=/rails/backups
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=finance-tracking/backups
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_FORCE_PATH_STYLE=false
# BACKUP_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY_ID=primary
# BACKUP_ENCRYPTION_PREVIOUS_KEYS=
# Local Docker can mount an existing AWS CLI profile, including `aws login`
# credentials, read-only into the web and worker containers.
# AWS_CONFIG_HOST_PATH=/absolute/path/to/.aws
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# Optional GitHub release update check overrides. By default the app checks
# taimoorq/expense_tracker and links the sidebar update button to the README's
# self-hosted update instructions.
# GITHUB_UPDATE_CHECKS_ENABLED=true
# GITHUB_UPDATE_REPOSITORY=taimoorq/expense_tracker
# GITHUB_UPDATE_TOKEN=
# GITHUB_UPDATE_README_URL=https://github.com/taimoorq/expense_tracker#updating-a-self-hosted-install
