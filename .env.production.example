# Copy to .env.production for a public self-hosted deployment.
# Example:
#   cp .env.production.example .env.production

APP_HOST=budget.example.com
APP_PROTOCOL=https
ALLOWED_HOSTS=budget.example.com

RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MASTER_KEY=replace-with-your-master-key
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Optional: pin or override the prebuilt app image used by docker-compose.production.yml.
# Use a version tag for repeatable deploys.
# GHCR example: ghcr.io/taimoorq/expense_tracker:v2.0.0
EXPENSE_TRACKER_IMAGE=ghcr.io/taimoorq/expense_tracker:latest

# Set both to false when running over HTTP (e.g. LAN without HTTPS).
# Cookies and redirects will work over plain HTTP.
ASSUME_SSL=true
FORCE_SSL=true

# Optional Cloudflare Turnstile protection for Devise sign-in/sign-up/reset flows.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

POSTGRES_DB=expense_tracker_production
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgres://expense_tracker:replace-with-a-strong-password@db:5432/expense_tracker_production

# Automatic workspace backups are disabled until durable storage and an
# encryption key are configured. BACKUP_HOST_PATH may point at a dedicated
# disk or a mounted NAS/NFS path on the Docker host.
BACKUP_STORAGE_DRIVER=disabled
BACKUP_HOST_PATH=./backups
BACKUP_LOCAL_ROOT=/rails/backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=finance-tracking/backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_FORCE_PATH_STYLE=false
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_ID=primary
# JSON object containing old key IDs and Base64 keys during key rotation.
BACKUP_ENCRYPTION_PREVIOUS_KEYS=
